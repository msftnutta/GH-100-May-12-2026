# Copy this file to `.env` and fill in your own values.
# Do NOT commit the real `.env` file.

# Azure Maps subscription key (Authentication blade in Azure portal)
AZURE_MAPS_KEY=your-azure-maps-subscription-key

# Azure Maps endpoint. Use the regional host you provisioned, e.g.:
#   https://atlas.microsoft.com           (global)
#   https://us.atlas.microsoft.com        (US)
#   https://eu.atlas.microsoft.com        (Europe)
AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com

# Port the Node server listens on
PORT=3000
